# RAG Academy Environment Variables

# ============================================
# Supabase Configuration
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# Email Configuration (Resend)
# ============================================
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@ragacademy.com
EMAIL_DOMAIN=ragacademy.com
RESEND_WEBHOOK_SECRET=your-webhook-secret

# ============================================
# Payment Configuration (Polar/Paddle)
# ============================================
POLAR_ACCESS_TOKEN=polar_at_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POLAR_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Polar Product Price IDs
POLAR_PRODUCT_PRO_MONTHLY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
POLAR_PRODUCT_PRO_ANNUAL=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
POLAR_PRODUCT_TEAM_MONTHLY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
POLAR_PRODUCT_TEAM_ANNUAL=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
POLAR_PRODUCT_LIFETIME=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ============================================
# Cron Job Security
# ============================================
CRON_SECRET=your-secure-cron-secret

# ============================================
# Email Unsubscribe Security
# ============================================
UNSUBSCRIBE_SECRET=your-secure-unsubscribe-secret

# ============================================
# App Configuration
# ============================================
NEXT_PUBLIC_APP_URL=https://rag-academy.com
NODE_ENV=production

# ============================================
# AI/LLM Configuration (Optional)
# ============================================
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# MCP (local stdio server: npm run mcp:dev)
# ============================================
# Absolute links in tool responses (optional)
# RAG_ACADEMY_SITE_URL=https://your-deployment.example
# Reuse app URL if already set: NEXT_PUBLIC_APP_URL / NEXT_PUBLIC_SITE_URL
# Authenticated tools (progress + recommendations) call your deployed API:
# RAG_ACADEMY_API_BASE_URL=https://your-deployment.example
# RAG_ACADEMY_SUPABASE_ACCESS_TOKEN=<user JWT from browser session>
# Bypass in-process MCP rate limits (local dev only; do not ship enabled)
# RAG_ACADEMY_MCP_DISABLE_RATE_LIMIT=true
