{
  "name": "rag-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:search-index && next dev --disable-source-maps",
    "dev:webpack": "next dev --webpack",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:challenges": "node scripts/validate-challenges.mjs",
    "validate:next-env": "node scripts/validate-next-env.mjs",
    "build:search-index": "node scripts/build-search-index.mjs",
    "build": "npm run validate:next-env && npm run validate:content && npm run validate:challenges && npm run build:search-index && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@polar-sh/sdk": "^0.45.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.52.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "gray-matter": "^4.0.3",
    "ioredis": "^5.10.1",
    "lucide-react": "^0.563.0",
    "monaco-editor": "^0.55.1",
    "next": "16.0.10",
    "next-mdx-remote": "^5.0.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "remark-gfm": "^4.0.1",
    "resend": "^6.6.0",
    "rss-parser": "^3.13.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "jsdom": "^29.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.2"
  }
}
