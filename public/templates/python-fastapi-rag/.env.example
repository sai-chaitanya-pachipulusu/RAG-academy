# RAG Academy — Environment Configuration
# Copy to .env and fill in your values

# ─────────────────────────────────────────────────────────────
# LLM Provider
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# Model selection
EMBEDDING_MODEL=text-embedding-3-small
GENERATION_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────────────────────
# Vector Database
# ─────────────────────────────────────────────────────────────
# Options: chroma, pinecone, qdrant, pgvector
VECTOR_DB=chroma

# Pinecone (if using)
# PINECONE_API_KEY=...
# PINECONE_INDEX=rag-academy
# PINECONE_ENVIRONMENT=us-east-1

# Qdrant (if using)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=...

# PostgreSQL + pgvector (if using)
# DATABASE_URL=postgresql://user:pass@localhost:5432/ragdb

# ─────────────────────────────────────────────────────────────
# Chunking
# ─────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# ─────────────────────────────────────────────────────────────
# Retrieval
# ─────────────────────────────────────────────────────────────
TOP_K=10
HYBRID_ALPHA=0.7  # 0=sparse only, 1=dense only

# ─────────────────────────────────────────────────────────────
# Reranking
# ─────────────────────────────────────────────────────────────
RERANK_ENABLED=true
RERANK_TOP_N=5
# COHERE_API_KEY=...  # For Cohere Rerank

# ─────────────────────────────────────────────────────────────
# Safety & Limits
# ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
MAX_TOKENS_CONTEXT=4000
